{
  "name": "goodgrails-seller",
  "version": "2.0.0",
  "description": "Multichannel specialist-book seller on Cloudflare Workers (D1 + R2 + KV)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute bookstore-db --local --file=migrations/0001_multichannel.sql",
    "db:migrate:remote": "wrangler d1 execute bookstore-db --remote --file=migrations/0001_multichannel.sql",
    "db:schema:local": "wrangler d1 execute bookstore-db --local --file=schema.sql",
    "db:schema:remote": "wrangler d1 execute bookstore-db --remote --file=schema.sql",
    "mcp": "node mcp/server.mjs",
    "mcp:http": "node mcp/http.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241022.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.3",
    "vitest": "^1.0.0",
    "wrangler": "^3.80.0",
    "zod": "^4.6.7"
  }
}
